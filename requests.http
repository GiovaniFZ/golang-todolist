@baseUrl = http://localhost:8080

# @name Register
POST {{baseUrl}}/sign-up
Content-Type: application/json

{
    "Name": "John Doe",
    "Email": "john@example2.com",
    "Password": "12345"
}
###

# @name Login
POST {{baseUrl}}/login
Content-Type: application/json

{
    "Email": "john@example2.com",
    "Password": "12345"
}
@authToken = {{Login.response.body.access_token}}
###

# @name Create Task
POST {{baseUrl}}/tasks
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "Name": "Birthday",
    "Description": "My mother's birthday",
    "StartsAt": "2027-07-04T16:31:28.870Z",
    "EndsAt": "2026-07-05T18:31:28.870Z"
}

###

# @name Get Tasks
GET {{baseUrl}}/tasks
Authorization: Bearer {{authToken}}
###
@taskId = cd0dc3e8-a14c-45ab-bcc3-9bcd413398f3

# @name Update Task
PATCH {{baseUrl}}/tasks/{{taskId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "Name": "Updated Birthday",
    "Description": "My mother's updated birthday",
    "StartsAt": "2027-07-04T16:31:28.870Z",
    "EndsAt": "2026-07-05T18:31:28.870Z"
}

###

# @name Delete Task
DELETE {{baseUrl}}/tasks/{{taskId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}
###
